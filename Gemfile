source 'https://rubygems.org'

gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-paginate"
end

# Dart Sass (ships with Jekyll 4); keeps SCSS compilation modern.
gem "jekyll-sass-converter", "~> 3.0"

# Needed to run `jekyll serve` locally on Ruby 3.x.
gem "webrick", "~> 1.9"
